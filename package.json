{
  "name": "b-fac",
  "version": "0.1.0",
  "private": true,
  "description": "Tooling for the b-fac repository itself. Not the published plugin payload.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"scripts/*.test.mjs\"",
    "sync": "node scripts/sync-harnesses.mjs",
    "check:sync": "node scripts/sync-harnesses.mjs --check",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:collisions": "node scripts/check-collisions.mjs",
    "check:version": "node scripts/check-version-bump.mjs",
    "check:plugin": "claude plugin validate . --strict",
    "check:plugin-load": "node scripts/check-plugin-load.mjs",
    "check": "npm run test && npm run check:sync && npm run check:vocabulary && npm run check:collisions && npm run check:version"
  }
}
