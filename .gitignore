node_modules/
dist/
*.log

# Resumable state written by docs/process/seed-issues.py. Local bookkeeping for
# a one-shot script, not a record: committing it means a fresh clone believes
# the backlog is already seeded.
docs/process/issues-created.json

# Local harness state, not the committed adapter output
.claude/settings.local.json

# Agent worktrees. Committing one adds a gitlink that breaks every clone, and
# `git add -A` from the repo root picks them up silently. parallelism.md
# records this happening on another project; it happened here too.
.claude/worktrees/
