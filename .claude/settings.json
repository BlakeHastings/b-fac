{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-merge.mjs\"",
            "if": "Bash(gh *)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
